- is_mine = message.user_id == current_user_id
- if message.message_type == "call"
  - call = message.call
  - missed_for_me = call.present? && call.callee_id == current_user_id && call.status.in?(%w[missed declined])
  div class="flex justify-center message-row" data-message-id=message.id data-sender-id=message.user_id
    div class="flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-white/90 shadow-sm text-xs #{missed_for_me ? 'text-red-600' : 'text-gray-600'}"
      svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 3h4l2 7-2.5 1.5a11 11 0 006 6L13 15l7 2v4a2 2 0 01-2 2A16 16 0 012 5a2 2 0 012-2z"

      - if call&.call_type == "video"
        svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.55-2.28A1 1 0 0121 8.62v6.76a1 1 0 01-1.45.9L15 14M4 6h9a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V8a2 2 0 012-2z"

      span = message.body

      - if message.duration_in_seconds.to_i > 0
        - secs = message.duration_in_seconds.to_i
        span class="tabular-nums" = "· #{secs / 60}:#{(secs % 60).to_s.rjust(2, '0')}"

      span class="text-gray-400" = message.created_at.strftime("%I:%M %p").sub(/^0/, '')

      - if call.present?
        button type="button" class="call-delete-trigger ml-1 text-gray-300 hover:text-gray-500" data-call-message-id=message.id data-call-id=call.id title="Delete"
          svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"

- elsif message.deleted_for_everyone?
  div class="flex #{is_mine ? 'justify-end' : 'justify-start'} message-row" data-message-id=message.id data-sender-id=message.user_id
    div class="max-w-[75%] sm:max-w-[65%] rounded-2xl px-3 py-2 bg-white/60 rounded-bl-md"
      p class="text-xs italic text-gray-400" This message was deleted

- else
  div class="flex #{is_mine ? 'justify-end' : 'justify-start'} message-row #{'message-row--mine' if is_mine}" data-message-id=message.id data-sender-id=message.user_id
    div class="group relative max-w-[75%] sm:max-w-[65%] rounded-2xl px-3 py-2 shadow-sm message-bubble #{is_mine ? 'bg-[#ffffff] rounded-br-md message-bubble--mine' : 'bg-white rounded-bl-md'}"

      button type="button" class="message-delete-trigger absolute -top-2 -left-2 hidden group-hover:flex w-6 h-6 rounded-full bg-white shadow items-center justify-center text-red-500 hover:text-red-600" data-message-id=message.id data-is-mine="#{is_mine}" title="Delete"
        svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"

      - if message.body.present?
        p class="text-sm sm:text-[15px] text-gray-800 whitespace-pre-wrap break-words" = message.body

      - if message.respond_to?(:attachments) && message.attachments.attached?
        - message.attachments.each do |attachment|
          - if attachment.content_type.to_s.start_with?("audio/")
            div class="voice-note-player flex items-center gap-2.5 py-1 min-w-[220px]" data-audio-src=url_for(attachment)
              button type="button" class="voice-play-btn shrink-0 w-9 h-9 rounded-full bg-[#1D4D3A] text-white flex items-center justify-center hover:bg-[#183f2f] active:bg-[#132f24] transition-colors"
                svg class="icon-play w-4 h-4 ml-0.5" fill="currentColor" viewBox="0 0 24 24"
                  path d="M8 5v14l11-7z"
                svg class="icon-pause hidden w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                  rect x="6" y="5" width="4" height="14"
                  rect x="14" y="5" width="4" height="14"

              div class="flex-1 flex items-center gap-2 min-w-0"
                div class="voice-note-progress relative flex-1 h-1.5 bg-black/10 rounded-full cursor-pointer"
                  div class="voice-note-progress-fill absolute inset-y-0 left-0 bg-[#1D4D3A] rounded-full" style="width:0%"
                  div class="voice-note-progress-handle absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-3 h-3 bg-[#1D4D3A] rounded-full shadow" style="left:0%"

                - has_server_duration = message.respond_to?(:duration_in_seconds) && message.duration_in_seconds.present?
                span class="voice-note-duration text-xs text-gray-500 tabular-nums shrink-0" data-has-server-duration=has_server_duration
                  - if has_server_duration
                    - secs = message.duration_in_seconds.to_i
                    = "#{secs / 60}:#{(secs % 60).to_s.rjust(2, '0')}"
                  - else
                    | 0:00

          - elsif attachment.content_type.to_s.start_with?("image/")
            = image_tag url_for(attachment), class: "rounded-lg max-w-full max-h-64 object-cover mt-1"

          - else
            = link_to attachment.filename.to_s, url_for(attachment), class: "flex items-center gap-2 mt-1 text-sm text-[#1D4D3A] underline break-all", target: "_blank"

      p class="text-[10px] text-gray-400 text-right mt-1"
        = message.created_at.strftime("%I:%M %p").sub(/^0/, '')