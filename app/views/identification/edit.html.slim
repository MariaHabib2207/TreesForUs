doctype html
html
  head
    = csrf_meta_tags
    = csp_meta_tag

  body class="bg-gray-100 min-h-screen flex items-center justify-center login-bg"
    div class="w-full max-w-5xl mx-auto px-4 py-8"
      div class="bg-white rounded-2xl shadow-xl overflow-hidden"
        div class="flex flex-col md:flex-row"

          / Left: form panel
          div class="w-full md:w-1/2 p-6 sm:p-10 flex flex-col justify-center"
            = image_tag "logo.png", class: "w-16 h-16 sm:w-20 sm:h-20 mx-auto mb-4"

            h1 class="text-center text-2xl sm:text-3xl font-bold text-green-900 mb-2"
              | Almost there!

            p class="text-center text-gray-500 text-sm mb-6"
              | Please confirm your details to complete sign up.

            = form_with url: update_identification_path, method: :patch, local: true do |f|
              div class="w-full sm:w-3/4 mx-auto space-y-4"

                / First Name
                div
                  = f.label :first_name, class: "block text-sm font-medium text-gray-700 mb-1"
                    | First Name
                    span class="text-red-500 ml-1" *
                  = f.text_field :first_name,
                    value: @user.first_name,
                    name: "user[first_name]",
                    required: true,
                    class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

                / Last Name
                div
                  = f.label :last_name, class: "block text-sm font-medium text-gray-700 mb-1"
                    | Last Name
                    span class="text-red-500 ml-1" *
                  = f.text_field :last_name,
                    value: @user.last_name,
                    name: "user[last_name]",
                    required: true,
                    class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

                / Gender
                div
                  = f.label :gender, class: "block text-sm font-medium text-gray-700 mb-1"
                    | Gender
                    span class="text-red-500 ml-1" *
                  = f.select :gender,
                    options_for_select([["Male", "male"], ["Female", "female"], ["Other", "other"]]),
                    { include_blank: "Select gender..." },
                    name: "user_profile[gender]",
                    required: true,
                    class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 bg-white"

                / Date of Birth
                div
                  = f.label :birth_date, class: "block text-sm font-medium text-gray-700 mb-1"
                    | Date of Birth
                    span class="text-red-500 ml-1" *
                  = f.date_field :birth_date,
                    name: "user_profile[birth_date]",
                    required: true,
                    max: Date.today.to_s,
                    class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

                / Identification Type
                div
                  = f.label :identification_type, class: "block text-sm font-medium text-gray-700 mb-1"
                    | Identification Type
                    span class="text-red-500 ml-1" *
                  = f.select :identification_type,
                    options_for_select(User.identification_types.map { |k, v| [k.humanize, k] }),
                    { include_blank: "Select type..." },
                    name: "user[identification_type]",
                    required: true,
                    class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 bg-white"

                / Identification Number
                div
                  = f.label :identification_number, class: "block text-sm font-medium text-gray-700 mb-1"
                    | Identification Number
                    span class="text-red-500 ml-1" *
                  = f.text_field :identification_number,
                    name: "user[identification_number]",
                    placeholder: "Enter your ID number",
                    required: true,
                    class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

                / Address
                div
                  = f.label :address, class: "block text-sm font-medium text-gray-700 mb-1"
                    | Address
                    span class="text-red-500 ml-1" *
                  = f.text_area :address,
                    name: "user_profile[address]",
                    rows: 2,
                    placeholder: "Street address",
                    required: true,
                    class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 resize-none"

                / Country
                div
                  = f.label :country, class: "block text-sm font-medium text-gray-700 mb-1"
                    | Country
                    span class="text-red-500 ml-1" *
                  = f.text_field :country,
                    name: "user_profile[country]",
                    placeholder: "e.g. Malaysia",
                    required: true,
                    class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

                / ZIP Code
                div
                  = f.label :zip, class: "block text-sm font-medium text-gray-700 mb-1"
                    | ZIP / Postcode
                    span class="text-red-500 ml-1" *
                  = f.text_field :zip,
                    name: "user_profile[zip]",
                    placeholder: "e.g. 47650",
                    required: true,
                    class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

                - if @user.errors.any?
                  div class="bg-red-50 border border-red-200 rounded-lg p-3"
                    - @user.errors.full_messages.each do |msg|
                      p class="text-red-600 text-sm" = msg

                = f.submit "Complete Sign Up",
                  class: "w-full bg-green-900 hover:bg-green-800 text-white py-3 rounded-lg transition cursor-pointer"

          / Right: image panel — hidden on mobile
          div class="hidden md:flex md:w-1/2 bg-gray-50 items-center justify-center p-10"
            = image_tag "login-page1.png",
              class: "max-w-full max-h-full object-contain rounded-lg shadow-md"
