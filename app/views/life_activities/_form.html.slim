div style="max-width:520px; margin:0 auto; padding:24px 16px;"
  = form_with model: [@owner, activity],
      class: "activity-form",
      multipart: true do |f|

    - if activity.errors.any?
      div style="background:#fef2f2; border:1px solid #fecaca; border-radius:12px; padding:14px 16px; margin-bottom:20px;"
        - activity.errors.full_messages.each do |msg|
          div style="font-size:13px; color:#dc2626; display:flex; align-items:center; gap:6px;"
            span ⚠️
            span = msg

    / ── Title ────────────────────────────────────────────────────
    div style="margin-bottom:14px;"
      label style="font-size:12px; font-weight:600; color:#374151; display:block; margin-bottom:6px;" Title
      = f.text_field :title,
          placeholder: "e.g. First trip to Japan",
          style: "width:100%; padding:10px 14px; border:1px solid #d1d5db; border-radius:10px; font-size:14px; font-family:inherit; box-sizing:border-box;"

    / ── Category ─────────────────────────────────────────────────
    div style="margin-bottom:14px;"
      label style="font-size:12px; font-weight:600; color:#374151; display:block; margin-bottom:6px;" Category
      = f.select :category,
          LifeActivity::CATEGORIES.map { |c| ["#{category_emoji_for(c)} #{c.humanize}", c] },
          { prompt: "Select category" },
          style: "width:100%; padding:10px 14px; border:1px solid #d1d5db; border-radius:10px; font-size:14px; background:white; font-family:inherit; box-sizing:border-box;"

    / ── Date & Location ──────────────────────────────────────────
    div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:14px;"
      div
        label style="font-size:12px; font-weight:600; color:#374151; display:block; margin-bottom:6px;" When?
        = f.date_field :occurred_on,
            max: Date.today,
            style: "width:100%; padding:10px 14px; border:1px solid #d1d5db; border-radius:10px; font-size:14px; font-family:inherit; box-sizing:border-box;"
      div
        label style="font-size:12px; font-weight:600; color:#374151; display:block; margin-bottom:6px;" Location
        = f.text_field :location,
            placeholder: "📍 Tokyo, Japan",
            style: "width:100%; padding:10px 14px; border:1px solid #d1d5db; border-radius:10px; font-size:14px; font-family:inherit; box-sizing:border-box;"

    / ── Description ──────────────────────────────────────────────
    div style="margin-bottom:14px;"
      label style="font-size:12px; font-weight:600; color:#374151; display:block; margin-bottom:6px;" Description (optional)
      = f.text_area :description,
          rows: 3,
          placeholder: "Tell the story behind this moment...",
          style: "width:100%; padding:10px 14px; border:1px solid #d1d5db; border-radius:10px; font-size:14px; resize:vertical; font-family:inherit; box-sizing:border-box;"

    / ── Visibility ───────────────────────────────────────────────
    div style="margin-bottom:14px;"
      label style="font-size:12px; font-weight:600; color:#374151; display:block; margin-bottom:8px;" Who can see this?
      div style="display:grid; grid-template-columns:repeat(2,1fr); gap:8px;"
        - LifeActivity::VISIBILITY_OPTIONS.each do |label_text, value|
          label style="cursor:pointer;"
            = f.radio_button :visibility, value, style: "display:none;", class: "visibility-radio"
            div class="visibility-option" style="text-align:center; padding:10px 8px; border:1.5px solid #d1d5db; border-radius:10px; font-size:11px; font-weight:600; color:#6b7280; transition:all .15s; user-select:none;"
              div style="font-size:20px; margin-bottom:4px;"
                = { "Only Me (Private)" => "🔒", "Friends Only" => "👥", "Family Only" => "🏠", "Friends & Family" => "🌐" }[label_text]
              div = label_text

    / ── Photos ───────────────────────────────────────────────────
    div style="margin-bottom:20px;"
      label style="font-size:12px; font-weight:600; color:#374151; display:block; margin-bottom:8px;"
        | Photos
        span style="font-weight:400; color:#9ca3af; margin-left:4px;" (max 10)

      label for="photo_upload_input" id="photo-drop-zone" style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; padding:24px 16px; border:2px dashed #d1d5db; border-radius:12px; cursor:pointer; background:#fafafa; transition:all .15s;"
        span style="font-size:26px;" 📷
        span style="font-size:13px; font-weight:600; color:#374151;" Tap to upload photos
        span style="font-size:11px; color:#9ca3af; text-align:center;" PNG, JPG, WEBP · Max 10MB each
        = f.file_field :photos,
            multiple: true,
            accept: "image/*",
            id: "photo_upload_input",
            style: "display:none;"

      div id="photo-preview-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(80px,1fr)); gap:8px; margin-top:12px;"

      - if activity.photos.attached?
        div style="margin-top:16px;"
          p style="font-size:12px; font-weight:600; color:#374151; margin-bottom:8px;" Current photos
          div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(80px,1fr)); gap:8px;"
            - activity.photos.each do |photo|
              div style="position:relative;"
                = image_tag url_for(photo), style: "width:100%; aspect-ratio:1; object-fit:cover; border-radius:10px; border:1px solid #e5e7eb; display:block;"
                label style="display:flex; align-items:center; gap:4px; margin-top:4px; font-size:11px; color:#dc2626; cursor:pointer;"
                  = check_box_tag "remove_photo_ids[]", photo.id, false, style: "accent-color:#dc2626;"
                  span Remove

    / ── Actions ──────────────────────────────────────────────────
    div style="display:flex; flex-direction:column; gap:10px; padding-top:16px; border-top:1px solid #f3f4f6;"
      = f.submit activity.persisted? ? "Save Changes" : "Add to Timeline",
          style: "width:100%; padding:12px; background:#1D4D3A; color:white; border:none; border-radius:999px; font-size:14px; font-weight:600; cursor:pointer; font-family:inherit;"
      = link_to "Cancel", user_life_activities_path(@owner),
          style: "display:block; text-align:center; font-size:13px; color:#6b7280; text-decoration:none; padding:8px;"

  javascript:
    document.getElementById("photo_upload_input").addEventListener("change", function () {
      const files = Array.from(this.files);
      const grid  = document.getElementById("photo-preview-grid");
      const zone  = document.getElementById("photo-drop-zone");
      grid.innerHTML = "";

      if (files.length > 10) {
        alert("Maximum 10 photos allowed.");
        this.value = "";
        return;
      }

      files.forEach(function (file) {
        const reader = new FileReader();
        reader.onload = function (e) {
          const item = document.createElement("div");
          item.innerHTML = '<img src="' + e.target.result + '" style="width:100%; aspect-ratio:1; object-fit:cover; border-radius:10px; border:1px solid #e5e7eb; display:block;" />';
          grid.appendChild(item);
        };
        reader.readAsDataURL(file);
      });

      zone.style.borderColor = "#1D4D3A";
      zone.style.background  = "#f0fdf4";
    });

    document.querySelectorAll(".visibility-radio").forEach(function (radio) {
      function highlight(el, on) {
        el.style.borderColor = on ? "#1D4D3A" : "#d1d5db";
        el.style.color       = on ? "#1D4D3A" : "#6b7280";
        el.style.background  = on ? "#f0fdf4"  : "white";
      }

      radio.addEventListener("change", function () {
        document.querySelectorAll(".visibility-option").forEach(function (opt) {
          highlight(opt, false);
        });
        highlight(this.nextElementSibling, true);
      });

      if (radio.checked) highlight(radio.nextElementSibling, true);
    });