doctype html
html
  head
    = csrf_meta_tags
    = csp_meta_tag

  body class="bg-gray-100 min-h-screen flex items-center justify-center login-bg"
    div class="w-full max-w-5xl mx-auto px-4 py-8"
      div class="bg-white rounded-2xl shadow-xl overflow-hidden"
        - if flash[:notice]
          p class="flash-message bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded"
            = flash[:notice]
        - if flash[:alert]
          p class="flash-message bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded"
            = flash[:alert]

        div class="flex flex-col md:flex-row"

          / Left: form panel
          div class="w-full md:w-1/2 p-6 sm:p-10 flex flex-col justify-center"
            = image_tag "logo.png", class: "w-16 h-16 sm:w-20 sm:h-20 mx-auto mb-4"
            h1 class="text-center text-2xl sm:text-3xl font-bold text-green-900 mb-2"
              | Trees For Us
            p class="text-center text-green-900 mb-2"
              | Discover. Connect. Belong.
            p class="text-center text-gray-900 text-sm mb-6"
              | Visualize your family. Explore your roots.
              br
              | Build your legacy for generations.

            div class="w-full sm:w-3/4 mx-auto space-y-4"
              = form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
                div class="space-y-4"
                  = f.email_field :email,
                    placeholder: "Email address",
                    class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"
                  = f.password_field :password,
                    placeholder: "Password",
                    class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

                  / REMEMBER ME + FORGOT PASSWORD
                  div class="flex items-center justify-between"
                    label class="flex items-center gap-2 cursor-pointer select-none"
                      = f.check_box :remember_me,
                        class: "w-4 h-4 rounded border-gray-300 accent-green-700 focus:ring-green-500 focus:ring-offset-0"
                      span class="text-sm text-gray-600" Keep me signed in
                    = link_to "Forgot password?",
                      new_password_path(resource_name),
                      class: "text-sm text-green-700 hover:underline"

                  = f.submit "Sign in",
                    class: "w-full bg-green-900 hover:bg-green-800 text-white py-3 rounded-lg transition cursor-pointer"

              div class="relative flex items-center my-4"
                div class="flex-grow border-t border-gray-200"
                span class="mx-3 text-xs text-gray-400 whitespace-nowrap"
                  | or continue with
                div class="flex-grow border-t border-gray-200"

              = link_to "#",
                onclick: "document.getElementById('google-auth-form').submit(); return false;",
                class: "w-full flex items-center justify-center gap-3 border border-gray-300 hover:border-gray-400 hover:bg-gray-50 text-gray-700 py-3 rounded-lg transition font-medium text-sm" do
                = image_tag "https://www.svgrepo.com/show/475656/google-color.svg",
                  class: "w-5 h-5",
                  alt: "Google logo"
                | Sign in with Google

              = form_tag user_google_oauth2_omniauth_authorize_path, method: :post, id: "google-auth-form"

              div class="text-center mt-4"
                span class="text-sm text-gray-600"
                  | Not already a user?
                = link_to " Sign up",
                  new_registration_path(resource_name),
                  class: "text-sm text-green-700 font-semibold hover:underline ml-1"

          / Right: image panel — hidden on mobile
          div class="hidden md:flex md:w-1/2 bg-gray-50 items-center justify-center p-10"
            = image_tag "login-page1.png",
              class: "max-w-full max-h-full object-contain rounded-lg shadow-md"

javascript:
  document.addEventListener("DOMContentLoaded", function () {
    setTimeout(function () {
      document.querySelectorAll(".flash-message").forEach(function (el) {
        el.style.transition = "opacity 0.5s ease";
        el.style.opacity = "0";
        setTimeout(() => el.remove(), 500);
      });
    }, 3000);
  });
