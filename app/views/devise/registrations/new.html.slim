doctype html
html
  head
    = csrf_meta_tags
    = csp_meta_tag

  body class="bg-gray-100 min-h-screen flex items-center justify-center login-bg"

    div class="w-full max-w-md bg-white rounded-2xl shadow-xl p-8 sm:p-10 mx-4 my-8"

      - if flash[:notice]
        p class="flash-message bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded mb-4"
          = flash[:notice]

      - if flash[:alert]
        p class="flash-message bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded mb-4"
          = flash[:alert]

      div class="flex flex-col items-center justify-center text-center mb-6"
        = image_tag "logo.png", class: "w-20 h-20 mb-5"
        h1 class="text-3xl font-bold text-green-900 mb-2" Tree Of Us
        p class="text-green-900 mb-2" Discover. Connect. Belong.
        p class="text-gray-900 text-sm"
          | Visualize your family. Explore your roots.
          br
          | Build your legacy for generations.

      / ── GOOGLE OAUTH ─────────────────────────────────────────────────────
      = link_to omniauth_authorize_path(resource_name, :google_oauth2),
          method: :post,
          class: "flex items-center justify-center gap-3 w-full border border-gray-300 rounded-lg py-3 px-4 mb-4 hover:bg-gray-50 transition duration-200" do
        svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-5 h-5 flex-shrink-0"
          path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.08 17.74 9.5 24 9.5z"
          path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
          path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
          path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-3.59-13.46-8.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
          path fill="none" d="M0 0h48v48H0z"
        span class="text-sm font-medium text-gray-700" Sign up with Google

      div class="flex items-center gap-3 mb-4"
        div class="flex-1 h-px bg-gray-200"
        span class="text-xs text-gray-400 font-medium" OR
        div class="flex-1 h-px bg-gray-200"

      = form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f|

        div class="space-y-4"

          = f.text_field :first_name,
            required: true,
            placeholder: "First Name",
            class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          = f.text_field :last_name,
            required: true,
            placeholder: "Last Name",
            class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          = f.email_field :email,
            required: true,
            placeholder: "Email Address",
            class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          = f.password_field :password,
            required: true,
            placeholder: "Password",
            class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          = f.password_field :password_confirmation,
            required: true,
            placeholder: "Confirm Password",
            class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          = f.fields_for :user_profile_attributes do |p|
            = p.date_field :birth_date,
              required: true,
              id: "birth_date_field",
              max: Date.today,
              class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

            = hidden_field_tag "user[user_profile_attributes][marital_status]", "", id: "marital_status_hidden"
            = p.select :marital_status,
              options_for_select(UserProfile.marital_status_options),
              { prompt: "Select Marital Status" },
              id: "marital_status_select",
              class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          = f.select :identification_type,
            options_for_select(User.identification_type_options),
            { prompt: "Select Identification Type" },
            class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          = f.text_field :identification_number,
            required: true,
            placeholder: "Identification Number",
            class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          p id="under16_family_hint" class="hidden text-xs text-amber-600 font-medium"
            |  You are under 16 — only Birth Family and Friend family types are available.

          / ── FAMILY SECTION ──────────────────────────────────────────────────
          div id="family_section"

            / Toggle tabs
            div class="flex rounded-lg border border-gray-200 overflow-hidden mb-3"
              button type="button" id="tab_code" class="flex-1 py-2 text-sm font-medium bg-green-900 text-white transition"
                | Enter Family Code
              button type="button" id="tab_new" class="flex-1 py-2 text-sm font-medium bg-white text-gray-600 hover:bg-gray-50 transition"
                | Create New Family

            / Panel: family code
            div id="panel_code"
              input type="text" name="family_code" id="family_code_input" placeholder="Enter your family code" value=params[:family_code].to_s autocomplete="off" class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 uppercase tracking-widest"
              p class="text-xs text-green-700 mt-1 ml-1"
                | Your family and membership type will be set automatically.

            / Panel: create new family
            div id="panel_new" class="hidden"
              = hidden_field_tag :new_family_name, "", id: "new_family_name_hidden"
              input type="text" id="new_family_name_input" placeholder="Enter new family name" autocomplete="off" class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"
              p class="text-xs text-green-700 mt-1 ml-1"
                | A new family tree will be created with this name.

              = hidden_field_tag :membership_type, "", id: "membership_type_hidden"
              = select_tag :membership_type,
                options_for_select(FamilyMembership.family_memberships_type_options),
                prompt: "Select Membership Type",
                id: "membership_type_select",
                class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 mt-3"

          - if @minimum_password_length
            p class="text-xs text-gray-500 text-center"
              = "#{@minimum_password_length} characters minimum"

          label class="flex items-center gap-3 cursor-pointer select-none"
            = f.check_box :remember_me,
              class: "w-4 h-4 rounded border-gray-300 text-green-700 focus:ring-green-500 focus:ring-offset-0 accent-green-700"
            span class="text-sm text-gray-600" Keep me signed in

          = f.submit "Create Account",
            class: "w-full bg-green-900 hover:bg-green-800 text-white py-3 rounded-lg transition duration-300 cursor-pointer"

          div class="text-center mt-2"
            span class="text-sm text-gray-600" Already have an account?
            = link_to " Sign in",
              new_session_path(resource_name),
              class: "text-sm text-green-700 font-semibold hover:underline ml-1"

javascript:
  document.addEventListener("DOMContentLoaded", function () {

    // ── Flash auto-dismiss ──────────────────────────────────────────────
    setTimeout(function () {
      document.querySelectorAll(".flash-message").forEach(function (el) {
        el.style.transition = "opacity 0.5s ease";
        el.style.opacity = "0";
        setTimeout(() => el.remove(), 500);
      });
    }, 3000);

    // ── Element references ──────────────────────────────────────────────
    const birthDateField       = document.getElementById("birth_date_field");
    const maritalStatusSelect  = document.getElementById("marital_status_select");
    const membershipSelect     = document.getElementById("membership_type_select");
    const membershipTypeHidden = document.getElementById("membership_type_hidden");
    const under16Hint          = document.getElementById("under16_family_hint");
    const maritalStatusHidden  = document.getElementById("marital_status_hidden");

    const tabCode    = document.getElementById("tab_code");
    const tabNew     = document.getElementById("tab_new");
    const panelCode  = document.getElementById("panel_code");
    const panelNew   = document.getElementById("panel_new");
    const codeInput  = document.getElementById("family_code_input");
    const newNameInput   = document.getElementById("new_family_name_input");
    const newNameHidden  = document.getElementById("new_family_name_hidden");

    // ── Tab switching ───────────────────────────────────────────────────
    function activateTab(tab) {
      if (tab === "code") {
        tabCode.classList.add("bg-green-900", "text-white");
        tabCode.classList.remove("bg-white", "text-gray-600");
        tabNew.classList.add("bg-white", "text-gray-600");
        tabNew.classList.remove("bg-green-900", "text-white");
        panelCode.classList.remove("hidden");
        panelNew.classList.add("hidden");
        // clear new family fields
        newNameInput.value  = "";
        newNameHidden.value = "";
        if (membershipSelect) membershipSelect.value = "";
      } else {
        tabNew.classList.add("bg-green-900", "text-white");
        tabNew.classList.remove("bg-white", "text-gray-600");
        tabCode.classList.add("bg-white", "text-gray-600");
        tabCode.classList.remove("bg-green-900", "text-white");
        panelNew.classList.remove("hidden");
        panelCode.classList.add("hidden");
        // clear code field
        codeInput.value = "";
      }
    }

    tabCode.addEventListener("click", () => activateTab("code"));
    tabNew.addEventListener("click",  () => activateTab("new"));

    // Auto-activate code tab if param present
    if (codeInput.value.trim().length > 0) activateTab("code");

    // Sync new family name to hidden field
    newNameInput.addEventListener("input", function () {
      newNameHidden.value = this.value.trim();
    });

    // ── DOB max ─────────────────────────────────────────────────────────
    const today = new Date().toISOString().split("T")[0];
    birthDateField.setAttribute("max", today);

    // ── Age rules ────────────────────────────────────────────────────────
    function calculateAge(dateString) {
      if (!dateString) return null;
      const birth = new Date(dateString);
      const now   = new Date();
      let age = now.getFullYear() - birth.getFullYear();
      const monthDiff = now.getMonth() - birth.getMonth();
      if (monthDiff < 0 || (monthDiff === 0 && now.getDate() < birth.getDate())) age--;
      return age;
    }

  function applyAgeRules() {
  const age = calculateAge(birthDateField.value);
  if (age === null) return;

  if (age < 16) {
    // Lock marital status to Single
    const singleOpt = Array.from(maritalStatusSelect.options)
      .find(o => o.text.toLowerCase() === "single" || o.value.toLowerCase() === "single");
    if (singleOpt) {
      maritalStatusSelect.value = singleOpt.value;
      maritalStatusHidden.value = singleOpt.value;
    }
    maritalStatusSelect.disabled = true;
    maritalStatusSelect.classList.add("opacity-50", "cursor-not-allowed");

    // Allow only Birth and Friend membership types
    if (membershipSelect) {
      Array.from(membershipSelect.options).forEach(opt => {
        const val = opt.value.toLowerCase();
        const txt = opt.text.toLowerCase();
        const isAllowed = val === "" ||
                          txt.includes("birth") || val.includes("birth") ||
                          txt.includes("friend") || val.includes("friend");
        opt.disabled = !isAllowed;
        opt.style.display = isAllowed ? "" : "none";
      });

      // If current selection is now disallowed, reset it
      const currentOpt = membershipSelect.options[membershipSelect.selectedIndex];
      if (currentOpt && currentOpt.disabled) {
        membershipSelect.value     = "";
        membershipTypeHidden.value = "";
      }

      membershipSelect.disabled = false;
      membershipSelect.classList.remove("opacity-50", "cursor-not-allowed");
    }

    if (under16Hint) under16Hint.classList.remove("hidden");

  } else {
    // Over 16 — unlock everything
    maritalStatusSelect.disabled = false;
    maritalStatusSelect.classList.remove("opacity-50", "cursor-not-allowed");
    maritalStatusHidden.value = "";

    if (membershipSelect) {
      Array.from(membershipSelect.options).forEach(opt => {
        opt.disabled = false;
        opt.style.display = "";
      });
      membershipSelect.disabled = false;
      membershipSelect.classList.remove("opacity-50", "cursor-not-allowed");
      membershipTypeHidden.value = "";}

    if (under16Hint) under16Hint.classList.add("hidden");}}

    birthDateField.addEventListener("change", applyAgeRules);
    applyAgeRules(); });