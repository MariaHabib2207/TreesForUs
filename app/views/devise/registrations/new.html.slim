doctype html
html
  head
    = csrf_meta_tags
    = csp_meta_tag

  body class="bg-gray-100 min-h-screen flex items-center justify-center login-bg"

    div class="w-full max-w-md bg-white rounded-2xl shadow-xl p-8 sm:p-10 mx-4 my-8"

      - if flash[:notice]
        p class="flash-message bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded mb-4"
          = flash[:notice]

      - if flash[:alert]
        p class="flash-message bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded mb-4"
          = flash[:alert]

      div class="flex flex-col items-center justify-center text-center mb-6"

        = image_tag "logo.png", class: "w-20 h-20 mb-5"

        h1 class="text-3xl font-bold text-green-900 mb-2" Tree Of Us

        p class="text-green-900 mb-2" Discover. Connect. Belong.

        p class="text-gray-900 text-sm"
          | Visualize your family. Explore your roots.
          br
          | Build your legacy for generations.

      = form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f|

        div class="space-y-4"

          / BASIC INFO
          = f.text_field :first_name,
            required: true,
            placeholder: "First Name",
            class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          = f.text_field :last_name,
            required: true,
            placeholder: "Last Name",
            class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          = f.email_field :email,
            required: true,
            placeholder: "Email Address",
            class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          = f.password_field :password,
            required: true,
            placeholder: "Password",
            class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          = f.password_field :password_confirmation,
            required: true,
            placeholder: "Confirm Password",
            class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

  
          = f.fields_for :user_profile_attributes do |p|

            = p.date_field :birth_date,
              required: true,
              id: "birth_date_field",
              max: Date.today,
              class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

            = hidden_field_tag "user[user_profile_attributes][marital_status]", "", id: "marital_status_hidden"
            = p.select :marital_status,
              options_for_select(UserProfile.marital_status_options),
              { prompt: "Select Marital Status" },
              id: "marital_status_select",
              class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"


          = f.select :identification_type,
            options_for_select(User.identification_type_options),
            { prompt: "Select Identification Type" },
            class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          = f.text_field :identification_number,
            required: true,
            placeholder: "Identification Number",
            class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          p id="under16_family_hint" class="hidden text-xs text-amber-600 font-medium"
            | You are under 16 — family type is set to Birth Family automatically.

          / Hidden fields submitted with the form
          = hidden_field_tag :family_id, "", id: "family_id_hidden"
          = hidden_field_tag :new_family_name, "", id: "new_family_name_hidden"

          / Hidden Rails select — used only as a data source for the JS combobox
          = select_tag :_family_data_source,
            options_from_collection_for_select(Family.all, :id, :name),
            id: "family_data_source",
            style: "display:none"

          / ── FAMILY COMBOBOX WIDGET ────────────────────────────────────────
          div id="family_widget" class="relative"

            / STATE 1: Search/select mode (default)
            div id="family_search_mode"
              div class="relative"
                input#family_search_input type="text" placeholder="Search or select a family..." autocomplete="off" class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 pr-10"
                span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-gray-400"
                  svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                    path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"

              div#family_dropdown class="hidden absolute z-50 w-full mt-1 bg-white border border-gray-200 rounded-lg shadow-lg max-h-56 overflow-y-auto"
                ul#family_options_list class="py-1"
                li#family_create_option class="flex items-center gap-2 px-4 py-3 text-green-700 font-semibold cursor-pointer hover:bg-green-50 border-t border-gray-100"
                  svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                    path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"
                  span#family_create_label Create new family

            / STATE 2: Create new family mode
            div#family_create_mode class="hidden"
              div class="relative"
                input#family_new_input type="text" placeholder="Enter new family name..." autocomplete="off" class="w-full px-4 py-3 border-2 border-green-500 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 pr-10"
                button#family_cancel_btn type="button" title="Cancel" class="absolute inset-y-0 right-3 flex items-center text-gray-400 hover:text-red-500 transition"
                  svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                    path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"
              p class="text-xs text-green-700 mt-1 ml-1" A new family will be created with this name.

          / Membership type — auto-locked to Birth Family for users under 16
          / Hidden carries value when select is disabled (browsers skip disabled fields)
          = hidden_field_tag :membership_type, "", id: "membership_type_hidden"
          = select_tag :membership_type,
            options_for_select(FamilyMembership.family_memberships_type_options),
            prompt: "Select Membership Type",
            id: "membership_type_select",
            class: "w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500",
            required: true

          - if @minimum_password_length
            p class="text-xs text-gray-500 text-center"
              = "#{@minimum_password_length} characters minimum"

          / REMEMBER ME
          label class="flex items-center gap-3 cursor-pointer select-none"
            = f.check_box :remember_me,
              class: "w-4 h-4 rounded border-gray-300 text-green-700 focus:ring-green-500 focus:ring-offset-0 accent-green-700"
            span class="text-sm text-gray-600" Keep me signed in

          = f.submit "Create Account",
            class: "w-full bg-green-900 hover:bg-green-800 text-white py-3 rounded-lg transition duration-300 cursor-pointer"

          div class="text-center mt-2"
            span class="text-sm text-gray-600" Already have an account?
            = link_to " Sign in",
              new_session_path(resource_name),
              class: "text-sm text-green-700 font-semibold hover:underline ml-1"

javascript:
  document.addEventListener("DOMContentLoaded", function () {

    // ── Flash auto-dismiss ──────────────────────────────────────────────────
    setTimeout(function () {
      document.querySelectorAll(".flash-message").forEach(function (el) {
        el.style.transition = "opacity 0.5s ease";
        el.style.opacity = "0";
        setTimeout(() => el.remove(), 500);
      });
    }, 3000);

    // ── Element references ──────────────────────────────────────────────────
    const birthDateField      = document.getElementById("birth_date_field");
    const maritalStatusSelect = document.getElementById("marital_status_select");
    const membershipSelect    = document.getElementById("membership_type_select");
    const under16Hint         = document.getElementById("under16_family_hint");
    const maritalStatusHidden = document.getElementById("marital_status_hidden");
    const membershipTypeHidden = document.getElementById("membership_type_hidden");

    // Family widget elements
    const familyIdHidden      = document.getElementById("family_id_hidden");
    const newFamilyNameHidden = document.getElementById("new_family_name_hidden");
    const familySearchMode    = document.getElementById("family_search_mode");
    const familyCreateMode    = document.getElementById("family_create_mode");
    const familySearchInput   = document.getElementById("family_search_input");
    const familyDropdown      = document.getElementById("family_dropdown");
    const familyOptionsList   = document.getElementById("family_options_list");
    const familyCreateOption  = document.getElementById("family_create_option");
    const familyCreateLabel   = document.getElementById("family_create_label");
    const familyNewInput      = document.getElementById("family_new_input");
    const familyCancelBtn     = document.getElementById("family_cancel_btn");

    // ── 1. Restrict DOB — no future dates ──────────────────────────────────
    const today = new Date().toISOString().split("T")[0];
    birthDateField.setAttribute("max", today);

    // ── 2. Age-based logic ──────────────────────────────────────────────────
    function calculateAge(dateString) {
      if (!dateString) return null;
      const birth = new Date(dateString);
      const now   = new Date();
      let age = now.getFullYear() - birth.getFullYear();
      const monthDiff = now.getMonth() - birth.getMonth();
      if (monthDiff < 0 || (monthDiff === 0 && now.getDate() < birth.getDate())) age--;
      return age;
    }

    function applyAgeRules() {
      const age = calculateAge(birthDateField.value);
      if (age === null) return;

      if (age < 16) {
        // Lock marital status to Single
        const singleOpt = Array.from(maritalStatusSelect.options)
          .find(o => o.text.toLowerCase() === "single" || o.value.toLowerCase() === "single");
        if (singleOpt) {
          maritalStatusSelect.value = singleOpt.value;
          maritalStatusHidden.value = singleOpt.value;  // sync hidden so disabled select still submits
        }
        maritalStatusSelect.disabled = true;

        // Lock membership type to Birth Family
        const birthOpt = Array.from(membershipSelect.options)
          .find(o => o.text.toLowerCase().includes("birth") || o.value.toLowerCase().includes("birth"));
        if (birthOpt) {
          membershipSelect.value     = birthOpt.value;
          membershipTypeHidden.value = birthOpt.value;  // sync hidden so disabled select still submits
        }
        membershipSelect.disabled = true;

        if (under16Hint) under16Hint.classList.remove("hidden");
      } else {
        // Unlock — clear hidden fields so they don't override the live selects
        maritalStatusSelect.disabled = false;
        membershipSelect.disabled    = false;
        maritalStatusHidden.value    = "";
        membershipTypeHidden.value   = "";
        if (under16Hint) under16Hint.classList.add("hidden");
      }
    }

    birthDateField.addEventListener("change", applyAgeRules);

    const dataSource = document.getElementById("family_data_source");
    const allFamilies = dataSource
      ? Array.from(dataSource.options)
          .filter(o => o.value !== "")
          .map(o => ({ id: o.value, name: o.text }))
      : [];

    let activeIndex = -1;

    function openDropdown() {
      familyDropdown.classList.remove("hidden");
    }

    function closeDropdown() {
      familyDropdown.classList.add("hidden");
      activeIndex = -1;
    }

    function renderOptions(query) {
      const q = query.trim().toLowerCase();
      const matched = q === ""
        ? allFamilies
        : allFamilies.filter(f => f.name.toLowerCase().includes(q));

      // Clear existing dynamic items
      familyOptionsList.innerHTML = "";

      if (matched.length === 0 && q !== "") {
        const li = document.createElement("li");
        li.className = "px-4 py-2 text-sm text-gray-400 italic";
        li.textContent = "No matching families found";
        familyOptionsList.appendChild(li);
      } else {
        matched.forEach(function (family) {
          const li = document.createElement("li");
          li.className = "px-4 py-3 text-sm text-gray-700 cursor-pointer hover:bg-green-50 hover:text-green-800 transition";
          li.textContent = family.name;
          li.dataset.id  = family.id;
          li.addEventListener("mousedown", function (e) {
            e.preventDefault();
            selectFamily(family.id, family.name);
          });
          familyOptionsList.appendChild(li);
        });
      }

      // Update "Create new family" label
      if (q !== "") {
        familyCreateLabel.textContent = `Create "${query.trim()}"`;
      } else {
        familyCreateLabel.textContent = "Create new family";
      }
    }

    function selectFamily(id, name) {
      familyIdHidden.value      = id;
      newFamilyNameHidden.value = "";
      familySearchInput.value   = name;
      closeDropdown();
    }

    function resetSearch() {
      familyIdHidden.value      = "";
      newFamilyNameHidden.value = "";
      familySearchInput.value   = "";
    }

    function enterCreateMode(prefill) {
      familySearchMode.classList.add("hidden");
      familyCreateMode.classList.remove("hidden");
      familyNewInput.value = prefill || "";
      newFamilyNameHidden.value = prefill || "";
      familyIdHidden.value = "";
      familyNewInput.focus();
    }

    function exitCreateMode() {
      familyCreateMode.classList.add("hidden");
      familySearchMode.classList.remove("hidden");
      familyNewInput.value      = "";
      newFamilyNameHidden.value = "";
      familyIdHidden.value      = "";
      familySearchInput.value   = "";
      familySearchInput.focus();
    }

    // Search input events
    familySearchInput.addEventListener("focus", function () {
      renderOptions(this.value);
      openDropdown();
    });

    familySearchInput.addEventListener("input", function () {
      // Clear any previously selected family id
      familyIdHidden.value = "";
      renderOptions(this.value);
      openDropdown();
    });

    familySearchInput.addEventListener("keydown", function (e) {
      const items = familyOptionsList.querySelectorAll("li[data-id]");
      if (e.key === "ArrowDown") {
        e.preventDefault();
        activeIndex = Math.min(activeIndex + 1, items.length - 1);
        items.forEach((li, i) => li.classList.toggle("bg-green-50", i === activeIndex));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        activeIndex = Math.max(activeIndex - 1, 0);
        items.forEach((li, i) => li.classList.toggle("bg-green-50", i === activeIndex));
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (activeIndex >= 0 && items[activeIndex]) {
          items[activeIndex].dispatchEvent(new MouseEvent("mousedown"));
        }
      } else if (e.key === "Escape") {
        closeDropdown();
      }
    });

    // "Create new family" option click
    familyCreateOption.addEventListener("mousedown", function (e) {
      e.preventDefault();
      enterCreateMode(familySearchInput.value.trim());
      closeDropdown();
    });

    // New family input — sync to hidden field
    familyNewInput.addEventListener("input", function () {
      newFamilyNameHidden.value = this.value.trim();
    });

    // Cancel button — back to search mode
    familyCancelBtn.addEventListener("click", function () {
      exitCreateMode();
    });

    // Close dropdown when clicking outside
    document.addEventListener("mousedown", function (e) {
      if (!document.getElementById("family_widget").contains(e.target)) {
        closeDropdown();
      }
    });

    // Initial render
    renderOptions("");

  });
