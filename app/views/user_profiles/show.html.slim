div class="min-h-screen bg-gray-100 p-4 sm:p-8"
  div class="max-w-6xl mx-auto bg-white rounded-2xl shadow-lg overflow-hidden"

    / HEADER
    div class="bg-green-900 px-5 py-5 sm:px-8 sm:py-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3"
      div
        h1 class="text-2xl sm:text-3xl font-bold text-white" User Profile
        p class="text-green-100 text-sm mt-1" Personal account overview

      div class="flex gap-2 sm:gap-3"
        = link_to "Edit Profile", edit_user_profile_path,
          class: "bg-white text-green-900 px-3 py-2 sm:px-4 rounded-lg text-sm font-medium hover:bg-gray-100 transition"

        = link_to "Back", root_path,
          class: "text-sm text-white hover:text-green-200 transition flex items-center"

    / BODY
    div class="p-5 sm:p-8"

      / TOP PROFILE STRIP
      div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 mb-8 sm:mb-10"

        div class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-4 sm:gap-6"
          div class="flex-shrink-0 self-center"
            - if @user_profile&.avatar&.attached?
              = image_tag @user_profile.avatar,
                class: "w-24 h-24 sm:w-28 sm:h-28 rounded-full border-4 border-green-700 object-cover shadow"
            - else
              = image_tag "logo.png",
                class: "w-24 h-24 sm:w-28 sm:h-28 rounded-full border-4 border-green-700 object-cover shadow"

          div
            h2 class="text-xl sm:text-2xl font-bold text-gray-800"
              = "#{@user.first_name} #{@user.last_name}"

            p class="text-gray-500 text-sm sm:text-base" = @user.email

            div class="mt-2"
              span class="inline-block bg-green-100 text-green-800 text-xs font-medium px-3 py-1 rounded-full"
                = @user.identification_type&.humanize || "Not set"

        / avatar upload
        div class="flex flex-col items-center sm:items-end gap-2"
          = form_with model: @user_profile,
                      url: user_profile_path,
                      method: :patch,
                      html: { multipart: true },
                      local: true do |f|

            = f.file_field :avatar,
              class: "text-sm text-gray-600 w-full sm:w-auto"

            = f.submit "Upload Photo",
              class: "mt-2 sm:mt-3 bg-green-900 hover:bg-green-800 text-white px-4 py-2 rounded-lg text-sm font-medium w-full sm:w-auto cursor-pointer"

      hr class="mb-8 sm:mb-10"

      / INFO GRID — stacks on mobile, side-by-side on sm+
      div class="grid grid-cols-1 sm:grid-cols-2 gap-8 sm:gap-10"

        / LEFT: Identity
        div class="flex flex-col gap-4"
          h3 class="text-lg font-semibold text-gray-800 mb-1" Identity Information

          div class="p-4 sm:p-5 bg-gray-50 rounded-xl"
            p class="text-sm text-gray-500" First Name
            p class="font-medium text-gray-900" = @user.first_name

          div class="p-4 sm:p-5 bg-gray-50 rounded-xl"
            p class="text-sm text-gray-500" Last Name
            p class="font-medium text-gray-900" = @user.last_name

          div class="p-4 sm:p-5 bg-gray-50 rounded-xl"
            p class="text-sm text-gray-500" Gender
            p class="font-medium text-gray-900" = @user_profile.gender.presence || "-"

          div class="p-4 sm:p-5 bg-gray-50 rounded-xl"
            p class="text-sm text-gray-500" Identification Type
            p class="font-medium text-gray-900" = @user.identification_type&.humanize || "-"

          div class="p-4 sm:p-5 bg-gray-50 rounded-xl"
            p class="text-sm text-gray-500" Identification Number
            p class="font-medium text-gray-900" = @user.identification_number || "-"

          div class="p-4 sm:p-5 bg-gray-50 rounded-xl"
            p class="text-sm text-gray-500" Birth Date
            p class="font-medium text-gray-900"
              = @user_profile.birth_date&.strftime("%d %B %Y") || "-"

          div class="p-4 sm:p-5 bg-gray-50 rounded-xl"
            p class="text-sm text-gray-500" Marital Status
            p class="font-medium text-gray-900" = @user_profile.marital_status.presence || "-"

        / RIGHT: Contact
        div class="flex flex-col gap-4"
          h3 class="text-lg font-semibold text-gray-800 mb-1" Contact & Details

          div class="p-4 sm:p-5 bg-gray-50 rounded-xl"
            p class="text-sm text-gray-500" Nationality
            p class="font-medium text-gray-900" = @user_profile.nationality.presence || "-"

          div class="p-4 sm:p-5 bg-gray-50 rounded-xl"
            p class="text-sm text-gray-500" Occupation
            p class="font-medium text-gray-900" = @user_profile.occupation.presence || "-"

          div class="p-4 sm:p-5 bg-gray-50 rounded-xl"
            p class="text-sm text-gray-500" Phone
            p class="font-medium text-gray-900" = @user_profile.phone.presence || "-"

          div class="p-4 sm:p-5 bg-gray-50 rounded-xl"
            p class="text-sm text-gray-500" Address
            p class="font-medium text-gray-900" = @user_profile.address.presence || "-"

          div class="p-4 sm:p-5 bg-gray-50 rounded-xl"
            p class="text-sm text-gray-500" City / State / Country
            p class="font-medium text-gray-900"
              = [@user_profile.city, @user_profile.state, @user_profile.country].compact.join(", ").presence || "-"

          div class="p-4 sm:p-5 bg-gray-50 rounded-xl"
            p class="text-sm text-gray-500" ZIP Code
            p class="font-medium text-gray-900" = @user_profile.zip.presence || "-"
