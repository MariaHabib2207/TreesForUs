div.min-h-screen.bg-gray-100.py-6.px-4.sm:py-10
  .max-w-4xl.mx-auto.bg-white.shadow-xl.rounded-2xl.overflow-hidden

    / HEADER
    .bg-green-900.px-5.py-5.sm:px-8.sm:py-6.flex.flex-col.sm:flex-row.sm:items-center.sm:justify-between.gap-3
      div
        h1.text-2xl.sm:text-3xl.font-bold.text-white Edit Profile
        p.text-green-100.text-sm.mt-1 Update your personal information
      = link_to "Back", user_profile_path, class: "bg-white text-green-900 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-100 transition self-start sm:self-auto"

    / BODY
    .p-5.sm:p-8
      = form_with model: @user_profile, url: user_profile_path, method: :patch, local: true do |f|

        / AVATAR
        .flex.flex-col.items-center.mb-8
          - if @user_profile.avatar.attached?
            = image_tag @user_profile.avatar, class: "w-24 h-24 sm:w-28 sm:h-28 rounded-full border-4 border-green-700 object-cover mb-3"
          - else
            = image_tag "logo.png", class: "w-24 h-24 sm:w-28 sm:h-28 rounded-full border-4 border-gray-300 object-cover mb-3"
          = f.file_field :avatar, class: "text-sm text-gray-600"

        / IDENTITY SECTION
        h3.text-lg.font-semibold.text-gray-800.mb-4.border-b.pb-2 Identity Information

        .grid.grid-cols-1.sm:grid-cols-2.gap-4.sm:gap-6.mb-6

          div
            = f.label :first_name, class: "block text-sm font-medium text-gray-700 mb-2"
            = f.text_field :first_name, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          div
            = f.label :last_name, class: "block text-sm font-medium text-gray-700 mb-2"
            = f.text_field :last_name, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          div
            .p-4.sm:p-5.bg-gray-50.rounded-xl.h-full
              p.text-sm.text-gray-500 Identification Type
              p.font-medium.text-gray-900 = @user.identification_type&.humanize || "-"

          div
            .p-4.sm:p-5.bg-gray-50.rounded-xl.h-full
              p.text-sm.text-gray-500 Identification Number
              p.font-medium.text-gray-900 = @user.identification_number || "-"

          div
            = f.label :birth_date, class: "block text-sm font-medium text-gray-700 mb-2"
            = f.date_field :birth_date, max: Date.current, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          / VITAL STATUS
          div.sm:col-span-2
            p.text-sm.font-medium.text-gray-700.mb-3 Vital Status

            = f.hidden_field :status, id: "status_field"

            label.flex.items-center.gap-4.cursor-pointer.mb-4
              = check_box_tag :is_alive, "1", @user_profile.death_date.blank?, id: "is_alive_checkbox", class: "h-5 w-5 rounded border-gray-300 text-green-700 focus:ring-green-700"
              span.text-sm.font-medium.text-gray-700 This person is alive

            #death_date_field.mt-2
              .bg-red-50.border.border-red-200.rounded-xl.p-4
                .flex.items-center.gap-2.mb-4
                  span.text-red-600.text-sm.font-medium ✝ Deceased — please enter the date of passing
                .space-y-2.max-w-xs
                  label.block.text-sm.font-medium.text-gray-700 Date of Death
                  = f.date_field :death_date, max: Date.current, id: "death_date_input", class: "w-full rounded-xl border border-red-300 px-4 py-3 focus:ring-2 focus:ring-red-400 focus:border-red-400"

        / CONTACT SECTION
        h3.text-lg.font-semibold.text-gray-800.mb-4.border-b.pb-2 Contact & Details

        .grid.grid-cols-1.sm:grid-cols-2.gap-4.sm:gap-6.mb-6

          div
            = f.label :gender, class: "block text-sm font-medium text-gray-700 mb-2"
            = f.select :gender, options_for_select([["Male", "male"], ["Female", "female"], ["Other", "other"]], @user_profile.gender), { prompt: "Select Gender" }, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          div
            = f.label :marital_status, class: "block text-sm font-medium text-gray-700 mb-2"
            = f.select :marital_status, options_for_select([["Single", "single"], ["Married", "married"], ["Divorced", "divorced"], ["Widowed", "widowed"]], @user_profile.marital_status), { prompt: "Select Status" }, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          div
            = f.label :nationality, class: "block text-sm font-medium text-gray-700 mb-2"
            = f.text_field :nationality, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          div
            = f.label :occupation, class: "block text-sm font-medium text-gray-700 mb-2"
            = f.text_field :occupation, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          div
            = f.label :phone, class: "block text-sm font-medium text-gray-700 mb-2"
            = f.telephone_field :phone, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          div
            = f.label :zip, "ZIP Code", class: "block text-sm font-medium text-gray-700 mb-2"
            = f.text_field :zip, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

        / ADDRESS
        .mb-6
          = f.label :address, class: "block text-sm font-medium text-gray-700 mb-2"
          = f.text_area :address, rows: 2, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 resize-none"

        / LOCATION
        .grid.grid-cols-1.sm:grid-cols-3.gap-4.sm:gap-6.mb-6

          div
            = f.label :city, class: "block text-sm font-medium text-gray-700 mb-2"
            = f.text_field :city, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          div
            = f.label :state, class: "block text-sm font-medium text-gray-700 mb-2"
            = f.text_field :state, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

          div
            = f.label :country, class: "block text-sm font-medium text-gray-700 mb-2"
            = f.text_field :country, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"

        / ACTION BUTTONS
        .mt-6.flex.flex-col-reverse.sm:flex-row.sm:items-center.sm:justify-end.gap-3.sm:gap-4
          = link_to "Cancel", user_profile_path, class: "w-full sm:w-auto text-center px-5 py-3 rounded-xl border border-gray-300 text-gray-700 hover:bg-gray-100 transition"
          = f.submit "Save Changes", class: "w-full sm:w-auto bg-green-900 hover:bg-green-800 text-white px-6 py-3 rounded-xl font-medium shadow-md transition cursor-pointer"

javascript:
  function initVitalStatus() {
    var checkbox     = document.getElementById("is_alive_checkbox");
    var statusField  = document.getElementById("status_field");
    var deathSection = document.getElementById("death_date_field");
    var dateField    = document.getElementById("death_date_input");
    if (!checkbox) return;

    function toggle() {
      var alive = checkbox.checked;
      statusField.value = alive ? "alive" : "dead";
      deathSection.classList.toggle("hidden", alive);
      if (alive && dateField) dateField.value = "";
    }

    checkbox.removeEventListener("change", toggle);
    checkbox.addEventListener("change", toggle);
    toggle();
  }

  document.addEventListener("DOMContentLoaded", initVitalStatus);
  document.addEventListener("turbo:load", initVitalStatus);
