- is_chat_invite = notification.event.type == "ChatInviteNotifier"
- is_chat_accepted = notification.event.type == "ChatInviteAcceptedNotifier"
- is_family_notification = notification.event.type == "NewFamilyMemberNotifier"
- url = notification.event.params[:url]
- chatroom_id = notification.event.params[:chatroom_id]

div class="px-4 py-3 hover:bg-gray-50 border-b border-gray-50 #{'bg-green-50' unless notification.read_at?}"
  div class="flex items-start justify-between gap-2"
    - if is_chat_accepted && chatroom_id.present?
      a href=chatroom_path(chatroom_id) class="flex-1 block"
        p class="text-sm text-gray-800 leading-snug"
          = notification.event.params[:message]
        p class="text-xs text-gray-400 mt-0.5"
          = notification.created_at.strftime("%b %d, %H:%M")
    - elsif url.present? && !is_family_notification && !is_chat_invite
      a href=url class="flex-1 block"
        p class="text-sm text-gray-800 leading-snug"
          = notification.event.params[:message]
        p class="text-xs text-gray-400 mt-0.5"
          = notification.created_at.strftime("%b %d, %H:%M")
    - else
      div class="flex-1"
        p class="text-sm text-gray-800 leading-snug"
          = notification.event.params[:message]
        p class="text-xs text-gray-400 mt-0.5"
          = notification.created_at.strftime("%b %d, %H:%M")

    = button_to notification_path(notification), method: :delete, class: "text-gray-300 hover:text-red-500 transition flex-shrink-0 bg-transparent border-none p-0 cursor-pointer", form: { data: { turbo_confirm: false } } do
      svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"

  / --- CHAT INVITE ACTIONS ---
  - if is_chat_invite && !notification.read_at?
    - inviter_id = notification.event.params[:inviter_id]
    div class="flex gap-2 mt-2"
      = button_to accept_chat_invite_notifications_path(notification_id: notification.id, inviter_id: inviter_id), method: :post, class: "flex-1 text-xs font-semibold text-white bg-green-600 hover:bg-green-700 px-3 py-1.5 rounded-lg transition text-center", form: { data: { turbo: false } } do
        | ✓ Accept
      = button_to reject_chat_invite_notifications_path(notification_id: notification.id, inviter_id: inviter_id), method: :post, class: "flex-1 text-xs font-semibold text-white bg-red-500 hover:bg-red-600 px-3 py-1.5 rounded-lg transition text-center", form: { data: { turbo: false } } do
        | ✗ Decline