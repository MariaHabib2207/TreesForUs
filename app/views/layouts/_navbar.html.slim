= stylesheet_link_tag "family_tree", media: "all"
= stylesheet_link_tag "life_activities", media: "all"

- unread_count = Message.joins(chatroom: :chatroom_members).where(chatroom_members: { user_id: current_user.id }).where(read_at: nil).where.not(user_id: current_user.id).count rescue 0

nav class="bg-white shadow-md px-5 py-4"
  div class="flex items-center justify-between"

    / LOGO
    a href="/" class="flex items-center space-x-3"
      = image_tag "logo.png", class: "w-8 h-8"
      span class="font-bold text-green-900 text-lg" Tree Of Us

    / DESKTOP NAV
    div class="hidden sm:flex items-center space-x-3"
      - unless current_page?(authenticated_root_path)
        = link_to authenticated_root_path, class: "text-sm font-medium text-white primary-btn hover:bg-green-700 px-4 py-2 rounded-lg transition" do
          | Dashboard

      - unless current_page?(new_relationship_path)
        = link_to new_relationship_path, class: "text-sm font-medium text-white primary-btn hover:bg-green-700 px-4 py-2 rounded-lg transition" do
          | Add Relationships

      - user_family = current_user.family_memberships.first&.family
      - if user_family
        - unless current_page?(activity_feed_family_path(user_family))
          = link_to activity_feed_family_path(user_family), class: "relative text-sm font-medium text-white primary-btn hover:bg-green-700 px-4 py-2 rounded-lg transition flex items-center gap-1" do
            i class="ti ti-activity" style="font-size: 16px;"
            | Activity

      - unless current_page?(user_life_activities_path(current_user))
        = link_to user_life_activities_path(current_user), class: "text-sm font-medium text-white primary-btn hover:bg-green-700 px-4 py-2 rounded-lg transition flex items-center gap-1" do
          i class="ti ti-timeline" style="font-size: 16px;"
          | Timeline

      - unless current_page?(chatrooms_path)
        = link_to chatrooms_path, class: "relative text-sm font-medium text-white primary-btn hover:bg-green-700 px-4 py-2 rounded-lg transition flex items-center gap-1" do
          div class="relative inline-flex items-center"
            i class="ti ti-messages" style="font-size: 16px;"
          span class="ml-1" Messages

      / GAMEROOM BUTTON (desktop)
      div class="relative" id="gameroom_wrapper_desktop"
        button type="button" id="gameroom-btn-desktop" class="text-sm font-medium text-white primary-btn hover:bg-green-700 px-4 py-2 rounded-lg transition flex items-center gap-1"
          i class="ti ti-device-gamepad-2" style="font-size: 16px;"
          | Gameroom

        div id="gameroom-backdrop-desktop" class="fixed inset-0 bg-black/40 z-40 sm:hidden" style="display:none;"

        div id="gameroom-panel-desktop" class="fixed inset-0 z-50 items-center justify-center p-4 sm:absolute sm:inset-auto sm:right-0 sm:left-auto sm:top-full sm:bottom-auto sm:mt-2 sm:p-0" style="display:none;"
          div class="w-full max-w-sm sm:w-80 max-h-[80vh] sm:max-h-96 bg-white rounded-lg shadow-xl border border-gray-100 flex flex-col overflow-hidden mx-auto"
            div class="flex items-center justify-between px-4 py-3 border-b border-gray-100 shrink-0"
              span class="font-semibold text-gray-800 text-sm" Gameroom
              div class="flex items-center gap-3"
                = link_to "View all", game_sessions_path, class: "text-xs text-green-700 hover:underline"
                button type="button" id="gameroom-close-btn-desktop" class="text-gray-400 hover:text-gray-600 p-1 -mr-1"
                  svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"

            div class="px-4 py-3 border-b border-gray-100 shrink-0"
              input type="text" id="gameroom-search-input-desktop" placeholder="Search people to invite..." class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2 focus:outline-none focus:border-green-700" autocomplete="off"

            div id="gameroom-search-results-desktop" class="overflow-y-auto flex-1 px-2 py-2"
              div class="px-2 py-6 text-center text-sm text-gray-400"
                | Search for someone to invite

      - unless current_page?(privacy_settings_path)
        = link_to privacy_settings_path, title: "Settings", class: "p-2 rounded-full text-green-900 hover:bg-gray-100 transition" do
          svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"

      = link_to user_profile_path(current_user), class: "flex items-center" do
        - profile = current_user.user_profile
        - if profile&.avatar&.attached?
          = image_tag profile.avatar, class: "w-10 h-10 rounded-full border-2 border-green-700 object-cover"
        - else
          = image_tag "logo.png", class: "w-10 h-10 rounded-full border-2 border-gray-300 object-cover"

      = render partial: 'shared/notification_bell', locals: { id_suffix: 'desktop' }

      = button_to destroy_user_session_path, method: :delete, class: "text-sm font-medium text-white bg-red-600 hover:bg-red-700 px-4 py-2 rounded-lg transition" do
        | Logout

    / MOBILE: avatar + hamburger
    div class="flex items-center gap-3 sm:hidden"
      = link_to user_profile_path(current_user), class: "flex items-center" do
        - profile = current_user.user_profile
        - if profile&.avatar&.attached?
          = image_tag profile.avatar, class: "w-9 h-9 rounded-full border-2 border-green-700 object-cover"
        - else
          = image_tag "logo.png", class: "w-9 h-9 rounded-full border-2 border-gray-300 object-cover"

      button id="mobile-menu-btn" class="text-green-900 focus:outline-none" aria-label="Toggle menu"
        svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"
        svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"

  / MOBILE MENU DROPDOWN
  div id="mobile-menu" class="hidden sm:hidden mt-3 flex flex-col gap-2 border-t pt-4"

    - unless current_page?(authenticated_root_path)
      = link_to authenticated_root_path, class: "text-sm font-medium text-white primary-btn hover:bg-green-700 px-4 py-2 rounded-lg transition text-center" do
        | Dashboard

    - unless current_page?(new_relationship_path)
      = link_to new_relationship_path, class: "text-sm font-medium text-white primary-btn hover:bg-green-700 px-4 py-2 rounded-lg transition text-center" do
        | Add Relationships

    - user_family = current_user.family_memberships.first&.family
    - if user_family
      - unless current_page?(activity_feed_family_path(user_family))
        = link_to activity_feed_family_path(user_family), class: "text-sm font-medium text-white primary-btn hover:bg-green-700 px-4 py-2 rounded-lg transition flex items-center justify-center gap-1" do
          i class="ti ti-activity" style="font-size: 16px;"
          | Activity

    - unless current_page?(user_life_activities_path(current_user))
      = link_to user_life_activities_path(current_user), class: "text-sm font-medium text-white primary-btn hover:bg-green-700 px-4 py-2 rounded-lg transition flex items-center justify-center gap-1" do
        i class="ti ti-timeline" style="font-size: 16px;"
        | Timeline

    - unless current_page?(chatrooms_path)
      = link_to chatrooms_path, class: "text-sm font-medium text-white primary-btn hover:bg-green-700 px-4 py-2 rounded-lg transition flex items-center justify-center gap-1" do
        div class="relative inline-flex items-center"
          i class="ti ti-messages" style="font-size: 16px;"
          - if unread_count > 0
            span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full w-4 h-4 flex items-center justify-center leading-none font-bold"
              = unread_count > 9 ? "9+" : unread_count.to_s
        span class="ml-1" Messages

    / GAMEROOM BUTTON (mobile)
    div class="relative" id="gameroom_wrapper_mobile"
      button type="button" id="gameroom-btn-mobile" class="w-full text-sm font-medium text-white primary-btn hover:bg-green-700 px-4 py-2 rounded-lg transition flex items-center justify-center gap-1"
        i class="ti ti-device-gamepad-2" style="font-size: 16px;"
        | Gameroom

      div id="gameroom-backdrop-mobile" class="fixed inset-0 bg-black/40 z-40" style="display:none;"

      div id="gameroom-panel-mobile" class="fixed inset-0 z-50 items-center justify-center p-4" style="display:none;"
        div class="w-full max-w-sm max-h-[80vh] bg-white rounded-lg shadow-xl border border-gray-100 flex flex-col overflow-hidden mx-auto"
          div class="flex items-center justify-between px-4 py-3 border-b border-gray-100 shrink-0"
            span class="font-semibold text-gray-800 text-sm" Gameroom
            div class="flex items-center gap-3"
              = link_to "View all", game_sessions_path, class: "text-xs text-green-700 hover:underline"
              button type="button" id="gameroom-close-btn-mobile" class="text-gray-400 hover:text-gray-600 p-1 -mr-1"
                svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"

          div class="px-4 py-3 border-b border-gray-100 shrink-0"
            input type="text" id="gameroom-search-input-mobile" placeholder="Search people to invite..." class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2 focus:outline-none focus:border-green-700" autocomplete="off"

          div id="gameroom-search-results-mobile" class="overflow-y-auto flex-1 px-2 py-2"
            div class="px-2 py-6 text-center text-sm text-gray-400"
              | Search for someone to invite

    - unless current_page?(privacy_settings_path)
      = link_to privacy_settings_path, class: "text-sm font-medium text-white primary-btn hover:bg-green-700 px-4 py-2 rounded-lg transition flex items-center justify-center gap-1" do
        svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
        span Settings

    = render partial: 'shared/notification_bell', locals: { id_suffix: 'mobile' }

    = button_to destroy_user_session_path, method: :delete, class: "w-full text-sm font-medium text-white bg-red-600 hover:bg-red-700 px-4 py-2 rounded-lg transition" do
      | Logout

javascript:
  (function() {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');

    if (!mobileMenuBtn || !mobileMenu) return;
    if (mobileMenuBtn.dataset.navInit === 'true') return;
    mobileMenuBtn.dataset.navInit = 'true';

    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!mobileMenuBtn.contains(e.target) && !mobileMenu.contains(e.target)) {
        mobileMenu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });
  })();
