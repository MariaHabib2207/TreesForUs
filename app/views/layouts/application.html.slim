doctype html
html class="h-full"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width,initial-scale=1"

    = turbo_frame_tag "modal"
    = stylesheet_link_tag "family_tree", media: "all"
    = stylesheet_link_tag "life_activities", media: "all"
    script src="https://cdn.tailwindcss.com"

    = favicon_link_tag "/favicon.ico"
    = csrf_meta_tags
    = csp_meta_tag

  body class="h-full flex flex-col overflow-hidden bg-cover bg-center bg-no-repeat bg-fixed" style="background-image: url(#{image_path('background-img.png')})"

    - if user_signed_in?
      = render "layouts/navbar"

      - if notice
        .mb-4.rounded-xl.border.border-green-200.bg-green-50.p-4.text-green-800.shadow-sm
          = notice

      - if alert
        .mb-4.rounded-xl.border.border-red-200.bg-red-50.p-4.text-red-800.shadow-sm
          = alert

    main class="flex-1 overflow-y-auto"
      = yield