body.login-bg

  = render "dashboard/chat_sidebar"

  .dashboard-layout style="padding-top:64px;"

    / USER SEARCH
    .user-search-wrap
      .user-search-box
        svg.user-search-icon viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"
          path d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        input type="text" id="user-search-input" placeholder="Search people..." autocomplete="off"
      #user-search-results.user-search-results

    / MAIN TREE AREA
    .dashboard-main
      - if @active_family&.friend_family?
        = render "friend_tree", members: @friend_members
      - else
        = render "family_tree", node: @family_tree, depth: 0

css:
  .user-search-wrap {
    position: relative;
    max-width: 420px;
    margin: 0 auto 20px auto;
    padding: 0 16px;
    z-index: 900;
  }

  .user-search-box {
    position: relative;
    display: flex;
    align-items: center;
  }

  .user-search-icon {
    position: absolute;
    left: 14px;
    width: 17px;
    height: 17px;
    color: #8a8473;
    pointer-events: none;
  }

  .user-search-box input {
    width: 100%;
    padding: 11px 16px 11px 40px;
    border-radius: 999px;
    border: 1px solid #e0dac9;
    background: #ffffff;
    font-size: 14px;
    color: #2c2c2c;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    box-sizing: border-box;
  }

  .user-search-box input:focus {
    outline: none;
    border-color: #1D4D3A;
    box-shadow: 0 0 0 3px rgba(29, 77, 58, 0.12);
  }

  .user-search-results {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 16px;
    right: 16px;
    background: #ffffff;
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
    max-height: 320px;
    overflow-y: auto;
    padding: 6px;
    box-sizing: border-box;
  }

  .user-search-results.is-visible {
    display: block;
  }

  .user-search-empty {
    padding: 18px 12px;
    text-align: center;
    color: #8a8473;
    font-size: 13px;
  }

  .user-search-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }

  .user-search-item:hover {
    background: #f5f1e8;
  }

  .user-search-item-avatar {
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: 50%;
    background: #1D4D3A;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 14px;
    overflow: hidden;
  }

  .user-search-item-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .user-search-item-body {
    min-width: 0;
  }

  .user-search-item-name {
    font-size: 14px;
    font-weight: 600;
    color: #1c1c1c;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .user-search-item-meta {
    font-size: 12px;
    color: #8a8473;
    margin: 2px 0 0 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

javascript:
  (function() {
    var input = document.getElementById('user-search-input');
    var results = document.getElementById('user-search-results');
    if (!input || !results || input.dataset.searchInit === 'true') return;
    input.dataset.searchInit = 'true';

    var debounceTimer = null;

    function escapeHtml(str) {
      var div = document.createElement('div');
      div.textContent = str || '';
      return div.innerHTML;
    }

    function renderResults(users) {
      if (users.length === 0) {
        results.innerHTML = '<p class="user-search-empty">No users found.</p>';
        results.classList.add('is-visible');
        return;
      }

      results.innerHTML = users.map(function(user) {
        var avatarHtml = user.avatar_url
          ? '<img src="' + escapeHtml(user.avatar_url) + '" alt="" />'
          : escapeHtml(user.initials || '');

        var metaParts = [];
        if (user.family_name) metaParts.push(escapeHtml(user.family_name));
        if (user.email) metaParts.push(escapeHtml(user.email));

        return '' +
          '<a href="' + escapeHtml(user.profile_path) + '" class="user-search-item">' +
            '<div class="user-search-item-avatar">' + avatarHtml + '</div>' +
            '<div class="user-search-item-body">' +
              '<p class="user-search-item-name">' + escapeHtml(user.name) + '</p>' +
              '<p class="user-search-item-meta">' + metaParts.join(' · ') + '</p>' +
            '</div>' +
          '</a>';
      }).join('');

      results.classList.add('is-visible');
    }

    function performSearch(query) {
      fetch('/search/users?q=' + encodeURIComponent(query), { headers: { 'Accept': 'application/json' } })
        .then(function(res) { return res.ok ? res.json() : null; })
        .then(function(data) {
          if (!data) return;
          renderResults(data.results);
        })
        .catch(function(err) { console.error('User search error:', err); });
    }

    input.addEventListener('input', function() {
      clearTimeout(debounceTimer);
      var query = input.value.trim();

      if (query.length < 1) {
        results.classList.remove('is-visible');
        results.innerHTML = '';
        return;
      }

      debounceTimer = setTimeout(function() { performSearch(query); }, 100);
    });

    document.addEventListener('click', function(e) {
      if (!input.contains(e.target) && !results.contains(e.target)) {
        results.classList.remove('is-visible');
      }
    });
  })();
