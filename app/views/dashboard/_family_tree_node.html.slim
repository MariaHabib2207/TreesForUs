
- node_user = node[:user]
- profile = node[:profile]
- children = node[:children] || []
- partners = node[:partners] || []
- active_family = params[:family_id]
- node_age = profile&.birth_date ? ((Date.today - profile.birth_date) / 365.25).floor : nil
- is_adult = node_age.nil? || node_age >= 16

div class="tree-node" data-depth=depth data-user-id=node_user.id

  div class="member-and-children"
    div class="couple-row"

      div class="card-wrapper js-card-hover"

        = link_to user_profile_path(node_user.id), class: "card #{"root" if depth == 0}", data: { turbo_frame: "modal" } do

          div class="avatar"
            - if profile&.avatar&.attached?
              = image_tag url_for(profile.avatar), class: "avatar-img"
            - else
              div class="avatar-initials"
                = "#{node_user&.first_name&.first}#{node_user&.last_name&.first}"

          div class="card-name"
            = "#{node_user.first_name} #{node_user.last_name}"

          div class="card-role" Member

          - if profile&.birth_date
            div class="card-age"
              = "Age #{node_age}"

          div class="tooltip"
            strong
              = "#{node_user.first_name} #{node_user.last_name}"
            div
              = profile&.occupation || "—"

        - if is_adult
          = link_to new_user_user_partner_path(user_id: node_user.id, family_id: params[:family_id], type: "partner"), class: "btn-add btn-add--spouse btn-add--dynamic", title: "Add spouse / partner", data: { turbo_frame: "modal" } do
            span class="btn-add__icon" +
            span class="btn-add__label" Spouse

          = link_to new_relationship_path(user_id: node_user.id, family_id: params[:family_id], type: "child"), class: "btn-add btn-add--child btn-add--dynamic", title: "Add child", data: { turbo_frame: "modal" } do
            span class="btn-add__icon" +
            span class="btn-add__label" Child

        / --- CHAT INVITE (main card) ---
        - if node_user != current_user && node_user.login_enabled?
          = button_to invite_to_chat_notifications_path(recipient_id: node_user.id), method: :post, class: "btn-add btn-add--chat btn-add--dynamic", title: "Invite to chat", form: { data: { turbo: false } } do
            span class="btn-add__icon" 💬
            span class="btn-add__label" Chat

        / --- INVITE (main card) ---
        - if node_user != current_user && !node_user.login_enabled?
          - if node_user.invitation_sent_at.present?
            div class="btn-add btn-add--invite btn-add--dynamic btn-add--invited"
              span class="btn-add__icon" ✉
              span class="btn-add__label" Invited
          - else
            = link_to new_user_invitation_path(user_id: node_user.id, type: "child", related_user_id: node_user.parents.first&.id), class: "btn-add btn-add--invite btn-add--dynamic", title: "Invite to app", data: { turbo_frame: "modal" } do
              span class="btn-add__icon" ✉
              span class="btn-add__label" Invite

      - partners.each do |partner|
        - p_profile = partner.user_profile
        - partner_age = p_profile&.birth_date ? ((Date.today - p_profile.birth_date) / 365.25).floor : nil
        - partner_is_adult = partner_age.nil? || partner_age >= 16

        div class="couple-connector"
          div class="couple-line"
          div class="couple-heart" ♥

        div class="card-wrapper js-card-hover"

          = link_to user_profile_path(partner), class: "card partner-card", id: "user_card_#{partner.id}", data: { turbo_frame: "modal" } do

            div class="avatar"
              - if p_profile&.avatar&.attached?
                = image_tag url_for(p_profile.avatar), class: "avatar-img"
              - else
                div class="avatar-initials"
                  = "#{partner&.first_name&.first}#{partner&.last_name&.first}"

            div class="card-name"
              = "#{partner.first_name} #{partner.last_name}"

            div class="card-role" Partner

            - if p_profile&.birth_date
              div class="card-age"
                = "Age #{partner_age}"

            div class="tooltip"
              strong
                = "#{partner.first_name} #{partner.last_name}"
              div
                = p_profile&.occupation || "—"

          / --- CHAT INVITE (partner card) ---
          - if partner != current_user && partner.login_enabled?
            = button_to invite_to_chat_notifications_path(recipient_id: partner.id), method: :post, class: "btn-add btn-add--chat btn-add--dynamic", title: "Invite to chat", form: { data: { turbo: false } } do
              span class="btn-add__icon" 💬
              span class="btn-add__label" Chat

          / --- INVITE (partner card) ---
          - if partner != current_user && !partner.login_enabled?
            - if partner.invitation_sent_at.present?
              div class="btn-add btn-add--invite btn-add--dynamic btn-add--invited"
                span class="btn-add__icon" ✉
                span class="btn-add__label" Invited
            - else
              = link_to new_user_invitation_path(user_id: partner.id, type: "partner", related_user_id: node_user.id), class: "btn-add btn-add--invite btn-add--dynamic", title: "Invite to app", data: { turbo_frame: "modal" } do
                span class="btn-add__icon" ✉
                span class="btn-add__label" Invite

    - if children.any?
      div class="children-branch"
        div class="children-row"
          - children.each do |child_node|
            div class="child-column"
              = render "family_tree_node", node: child_node, depth: depth + 1, family: active_family
