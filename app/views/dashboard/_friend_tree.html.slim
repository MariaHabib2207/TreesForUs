/ _friend_tree.html.slim
- current_user_profile = current_user.user_profile
- friend_nodes = members || []
- total = friend_nodes.size
- radius = 170
- if total.zero?
  div.friend-circle-empty
    p No friends yet. Use the button below to add your first friend.

  div(style="position: relative; width: 480px; height: 480px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;")
    div.card-wrapper
      = link_to user_profile_path(current_user.id), class: "card friend-card friend-card--current", data: { turbo_frame: "modal" } do
        div.avatar.avatar--lg
          - if current_user_profile&.avatar&.attached?
            = image_tag url_for(current_user_profile.avatar), class: "avatar-img"
          - else
            div.avatar-initials
              = "#{current_user.first_name.first}#{current_user.last_name.first}"
        div.card-name = "#{current_user.first_name} #{current_user.last_name}"
        div.card-role You

      = link_to new_friendship_path(user_id: current_user.id, family_id: params[:family_id]), class: "btn-add btn-add--friend btn-add--dynamic", title: "Add friend", data: { turbo_frame: "modal" } do
        span.btn-add__icon +
        span.btn-add__label Friend

- else
  div.friend-circle(data-family-id=params[:family_id] style="position: relative; width: 480px; height: 480px; margin: 0 auto;")

    svg(style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;" aria-hidden="true")
      - friend_nodes.each_with_index do |node, i|
        - angle = (2 * Math::PI * i / total) - Math::PI / 2
        - x = 240 + (radius * Math.cos(angle)).round
        - y = 240 + (radius * Math.sin(angle)).round
        line(x1="240" y1="240" x2="#{x}" y2="#{y}" stroke="var(--wire)" stroke-width="2")

    / --- CENTER: current user ---
    div(style="position: absolute; top: 240px; left: 240px; transform: translate(-50%, -50%); z-index: 2;")
      div.card-wrapper
        = link_to user_profile_path(current_user.id), class: "card friend-card friend-card--current", data: { turbo_frame: "modal" } do
          div.avatar.avatar--lg
            - if current_user_profile&.avatar&.attached?
              = image_tag url_for(current_user_profile.avatar), class: "avatar-img"
            - else
              div.avatar-initials
                = "#{current_user.first_name.first}#{current_user.last_name.first}"
          div.card-name = "#{current_user.first_name} #{current_user.last_name}"
          div.card-role You

        = link_to new_friendship_path(user_id: current_user.id, family_id: params[:family_id]), class: "btn-add btn-add--friend btn-add--dynamic", title: "Add friend", data: { turbo_frame: "modal" } do
          span.btn-add__icon +
          span.btn-add__label Friend

    / --- FRIEND NODES ---
    - friend_nodes.each_with_index do |node, i|
      - f_user    = node[:user]
      - f_profile = node[:profile]
      - f_age     = f_profile&.birth_date ? ((Date.today - f_profile.birth_date) / 365.25).floor : nil
      - angle     = (2 * Math::PI * i / total) - Math::PI / 2
      - x         = 240 + (radius * Math.cos(angle)).round
      - y         = 240 + (radius * Math.sin(angle)).round

      div(data-user-id=f_user.id style="position: absolute; top: #{y}px; left: #{x}px; transform: translate(-50%, -50%); z-index: 2;")
        div.card-wrapper
          = link_to user_profile_path(f_user.id), class: "card friend-card", data: { turbo_frame: "modal" } do
            div.avatar
              - if f_profile&.avatar&.attached?
                = image_tag url_for(f_profile.avatar), class: "avatar-img"
              - else
                div.avatar-initials
                  = "#{f_user.first_name.first}#{f_user.last_name.first}"
            div.card-name = "#{f_user.first_name} #{f_user.last_name}"
            div.card-role Friend
            - if f_age
              div.card-age = "Age #{f_age}"
            div.tooltip
              strong = "#{f_user.first_name} #{f_user.last_name}"
              div = f_profile&.occupation || "—"

          / --- ADD FRIEND ---
          = link_to new_friendship_path(user_id: f_user.id, family_id: params[:family_id]), class: "btn-add btn-add--friend btn-add--dynamic", title: "Add friend", data: { turbo_frame: "modal" } do
            span.btn-add__icon +
            span.btn-add__label Friend

          / --- INVITE (inside card-wrapper so hover works) ---
          - if f_user != current_user && !f_user.login_enabled?
            - if f_user.invitation_sent_at.present?
              div.btn-add.btn-add--invite.btn-add--dynamic.btn-add--invited
                span.btn-add__icon ✉
                span.btn-add__label Invited
            - else
              = link_to new_user_invitation_path(user_id: f_user.id, type: "friend", related_user_id: current_user.id), class: "btn-add btn-add--invite btn-add--dynamic", title: "Invite to app", data: { turbo_frame: "modal" } do
                span.btn-add__icon ✉
                span.btn-add__label Invite