//_notification_bell.html.slim
- suffix = local_assigns[:id_suffix] || "default"
- unread_count = current_user.noticed_notifications.where(read_at: nil).count

div class="relative" id="notification_bell_wrapper_#{suffix}"
  button class="relative text-green-900 hover:text-green-700 focus:outline-none p-2" type="button" id="bell-btn-#{suffix}" aria-label="Notifications"
    svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
      path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
    - if unread_count > 0
      span class="absolute -top-1 -right-1 bg-red-600 text-white text-[10px] font-bold rounded-full px-1.5 py-0.5 min-w-[16px] text-center leading-none"
        = unread_count

  / Backdrop — mobile only, click to close
  div id="notif-backdrop-#{suffix}" class="hidden fixed inset-0 bg-black/30 z-40 sm:hidden"

  div id="notif-dropdown-#{suffix}" class="hidden fixed inset-x-3 top-16 z-50 sm:absolute sm:inset-x-auto sm:right-0 sm:top-auto sm:mt-2 sm:w-80 max-h-[75vh] sm:max-h-96 bg-white rounded-lg shadow-xl border border-gray-100 flex-col overflow-hidden"
    div class="flex items-center justify-between px-4 py-3 border-b border-gray-100 shrink-0"
      span class="font-semibold text-gray-800 text-sm" Notifications
      div class="flex items-center gap-3"
        - if unread_count > 0
          = button_to "Mark all as read", mark_all_read_notifications_path, method: :patch, form: { data: { turbo_stream: true } }, class: "text-xs text-green-700 hover:underline bg-transparent border-none p-0 cursor-pointer"
        button type="button" id="notif-close-btn-#{suffix}" class="sm:hidden text-gray-400 hover:text-gray-600 p-1 -mr-1"
          svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"

    div class="overflow-y-auto flex-1"
      - recent = current_user.noticed_notifications.includes(:event).order(created_at: :desc).limit(8)
      - if recent.any?
        - recent.each do |notification|
          = render "notifications/notification_item", notification: notification
      - else
        div class="px-4 py-6 text-center text-sm text-gray-400"
          | No notifications yet

javascript:
  function initNotificationBell(suffix) {
    const btn = document.getElementById('bell-btn-' + suffix);
    const dropdown = document.getElementById('notif-dropdown-' + suffix);
    const backdrop = document.getElementById('notif-backdrop-' + suffix);
    const closeBtn = document.getElementById('notif-close-btn-' + suffix);

    if (!btn || !dropdown) return;
    if (btn.dataset.bellInit === 'true') return;
    btn.dataset.bellInit = 'true';

    function openDropdown() {
      dropdown.classList.remove('hidden');
      dropdown.classList.add('flex');
      backdrop?.classList.remove('hidden');
    }

    function closeDropdown() {
      dropdown.classList.add('hidden');
      dropdown.classList.remove('flex');
      backdrop?.classList.add('hidden');
    }

    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      if (dropdown.classList.contains('hidden')) {
        openDropdown();
      } else {
        closeDropdown();
      }
    });

    closeBtn?.addEventListener('click', closeDropdown);
    backdrop?.addEventListener('click', closeDropdown);

    document.addEventListener('click', function(e) {
      if (!dropdown.contains(e.target) && !btn.contains(e.target)) {
        closeDropdown();
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeDropdown();
    });
  }

  function initAllNotificationBells() {
    document.querySelectorAll('[id^="bell-btn-"]').forEach(function(btn) {
      const suffix = btn.id.replace('bell-btn-', '');
      initNotificationBell(suffix);
    });
  }

  document.addEventListener('turbo:load', initAllNotificationBells);
  document.addEventListener('DOMContentLoaded', initAllNotificationBells);
