.max-w-2xl.mx-auto.mt-10.px-4
  h1 class="text-xl font-semibold text-green-900 mb-6" Gameroom

  - if @game_sessions.empty?
    p class="text-sm text-gray-400 text-center py-10" No game rooms yet. Search for someone in the Gameroom panel to start one.
  - else
    .flex.flex-col.gap-3
      - @game_sessions.each do |game|
        - opponent = game.opponent_for(current_user)
        - can_cancel = game.cancellable_by?(current_user)
        div class="flex items-center justify-between gap-3 bg-white border border-gray-100 rounded-lg px-4 py-3 shadow-sm"
          a href=game_session_path(game) class="flex items-center gap-3 min-w-0 flex-1"
            div class="w-10 h-10 rounded-full bg-green-800 text-white flex items-center justify-center font-semibold text-sm shrink-0"
              = opponent.initials
            div class="min-w-0"
              p class="text-sm font-medium text-gray-800 truncate"
                = opponent.full_name
              p class="text-xs text-gray-400"
                - case game.status
                - when "pending"
                  = can_cancel ? "Pending" : "Awaiting your response"
                - when "active"
                  = game.my_turn?(current_user) ? "Your turn" : "#{opponent.full_name}'s turn"
                - when "finished"
                  - if game.winner
                    = game.winner_id == current_user.id ? "You won" : "You lost"
                  - else
                    | Draw
                - when "declined"
                  | Declined
                - else
                  = game.status.capitalize

          - if can_cancel
            = button_to cancel_game_session_path(game), method: :post, class: "text-gray-300 hover:text-red-500 transition shrink-0 bg-transparent border-none p-1.5 cursor-pointer", form: { data: { turbo_confirm: "Cancel this invite?" } } do
              svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"
          - else
            = button_to game_session_path(game), method: :delete, class: "text-gray-300 hover:text-red-500 transition shrink-0 bg-transparent border-none p-1.5 cursor-pointer", form: { data: { turbo_confirm: "Delete this game room?" } } do
              svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"